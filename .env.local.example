# Copy to .env.local (not committed). Read when `npm run dev` / `next build` starts.

# Clerk, DEVELOPMENT instance (Clerk dashboard > Configure > API keys). Locally always the pk_test_/sk_test_ pair;
# the server uses the production pair (pk_live_/sk_live_). The secret key must never be committed or shared.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Where the Spring Boot backend runs. Used server-side by the /api proxy in next.config.ts.
BACKEND_URL=http://localhost:8080

# Testing with real phones (e.g. against the online lobby, backend profile "online-lobby"):
# this computer's address on your Wi-Fi, without http:// or port. Must match the backend's JEOPARDY_PUBLIC_URL.
# Find it with `ipconfig` (IPv4 Address). Leave empty when you only test with browser tabs on this computer.
# ALLOWED_DEV_ORIGINS=192.168.1.20
